PROJECT_NAME=LexIntel-AI
VERSION=1.0.0

# Matches the PostgreSQL credentials and database in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexintel

EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# Supported providers: gemini, ollama
LLM_PROVIDER=ollama
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=llama3.2

# Required only when LLM_PROVIDER=gemini. Set your own key locally.
GEMINI_API_KEY=
