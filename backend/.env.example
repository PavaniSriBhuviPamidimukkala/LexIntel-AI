CORS_ALLOWED_ORIGINS=["http://localhost:5173","https://fuzzy-disco-g4p64x75w7g4hwrpp-5173.app.github.dev"]
MAX_UPLOAD_SIZE_BYTES=26214400
SQL_ECHO=false
ENVIRONMENT=development
AUTH_MODE=jwt
TRUSTED_PROXY_CIDRS=[]
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60